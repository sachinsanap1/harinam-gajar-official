# Copy this file to .env and fill in real values. Never commit .env.

SECRET_KEY=generate-a-long-random-string

# Leave DATABASE_URL unset to use local SQLite (fine for dev).
# For MySQL in production:
# DATABASE_URL=mysql+pymysql://db_user:db_password@localhost:3306/harinam_gajar

YOUTUBE_API_KEY=AIzaSyAULRMgc8TK5d9VGdhiKpT05n_yR8g4y3E
YOUTUBE_CHANNEL_HANDLE=HarinamGajarOfficial
YOUTUBE_CHANNEL_ID=
YOUTUBE_SYNC_INTERVAL_MINUTES=15

# Sync automatically once when the app starts (default true). Safe even
# without an API key set — it just skips silently.
ENABLE_STARTUP_SYNC=true
# Also sync on a repeating timer every YOUTUBE_SYNC_INTERVAL_MINUTES
# (default false — fine to leave off if you'll click "Sync Now" manually,
# or if your host doesn't suit a long-running in-process scheduler).
ENABLE_SCHEDULER=false

# Only needed for future Google integrations beyond YouTube Data API v3 —
# leave blank if you're only using YOUTUBE_API_KEY above.
GOOGLE_API_KEY=

# Protects /cron/sync-youtube (used on serverless hosts like Vercel that
# have no in-process scheduler — see README "Deploying to Vercel"). Leave
# blank if you're not deploying serverless; the route refuses to run
# without this set, so it can't be triggered by a stranger.
CRON_SECRET=

# Primary admin account — used by `flask sync-admin-from-env`.
# Creates the admin if none exists, or safely updates the existing one
# (matched by ADMIN_EMAIL) without creating a duplicate. Never hard-coded.
ADMIN_NAME=Sachin Sanap
ADMIN_EMAIL=harinamgajaroffcial@gmail.com
ADMIN_PASSWORD=Swami@123

MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=

SITE_NAME=हरिनाम गजर | Harinam Gajar Official
